public class DutchNationalFlag {
    static void main() {
        int [] arr = {0,1,2,0,1,2,1,0,2,1,0};
        int low = 0, mid = 0, high = arr.length -1;
        while(mid <= high){
            switch (arr[mid]){
                case 0:
                    int temp0 = arr[low];
                    arr[low] = arr[mid];
                    arr[mid] = temp0;
                    low++;
                    mid++;
                    break;
                case 1:
                    mid++;
                    break;
                case 2:
                    int temp2 = arr[mid];
                    arr[mid] = arr[high];
                    arr[high] = temp2;
                    high--;
                    break;
            }
        }
        System.out.println("Sorted array: ");
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}
