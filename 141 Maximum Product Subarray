public class MaxProductSubarraySimple {
    public static long maxProduct(int[] nums) {
        long maxProd = Long.MIN_VALUE;
        long prefix = 1, suffix = 1;
        int n = nums.length;

        for (int i = 0; i < n; i++) {
            // A zero wipes out the product. Reset to 1 to start a new subarray.
            if (prefix == 0) prefix = 1;
            if (suffix == 0) suffix = 1;

            prefix *= nums[i];
            suffix *= nums[n - 1 - i];

            // The answer is always the max of all prefixes and suffixes we've seen
            maxProd = Math.max(maxProd, Math.max(prefix, suffix));
        }

        return maxProd;
    }

    public static void main(String[] args) {
        int[] nums1 = {2, 3, -2, 4};
        System.out.println("Max product (nums1): " + maxProduct(nums1)); 
        // Expected Output: 6 (from subarray [2, 3])

        int[] nums2 = {-2, 0, -1};
        System.out.println("Max product (nums2): " + maxProduct(nums2)); 
        // Expected Output: 0 (from subarray [0])
        
        int[] nums3 = {2, -5, -2, -4, 3};
        System.out.println("Max product (nums3): " + maxProduct(nums3)); 
        // Expected Output: 24 (from subarray [-2, -4, 3])
    }
}
