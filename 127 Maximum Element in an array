import java.util.*;
public class MaximumElement {
    static void main() {
        int arr[]={1,20,300,4000,50000,600000,7000000,80000000,900000000,1000000000};
        int max=Integer.MIN_VALUE;
        for (int e :arr){
            if (e > max) {
                max=e;
            }
        }
        System.out.println("Max Element: "+max);
    }
}
