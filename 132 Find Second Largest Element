public class FindSecondLargestElement {
    public static void main(String[] args) {
        int[] arr = {1, 2, 4, 6, 4, 6, 3, 2, 1, 9, 10, 23, 44, 6, 54, 3, 4, 3, 2, 1, 5, 3, 4};
        
        // Initializing with Integer.MIN_VALUE is safer in case the array contains negative numbers
        int max1 = Integer.MIN_VALUE;
        int max2 = Integer.MIN_VALUE;

        for (int a : arr) {
            if (a > max1) {
                // The current element is the new largest. 
                // So, the old largest (max1) becomes the new second largest (max2).
                max2 = max1;
                max1 = a;
            } else if (a > max2 && a != max1) {
                // The current element is smaller than max1, but larger than max2.
                // We also check 'a != max1' to ensure we find the *distinct* second largest.
                max2 = a;
            }
        }
        
        System.out.println("Largest element: " + max1);
        System.out.println("Second largest element: " + max2);
    }
}
