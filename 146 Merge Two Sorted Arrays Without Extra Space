import java.util.Arrays;
public class MergeTwoSortedArraysWithoutExtraSpace {
    public static void merge(int[] arr1, int m, int[] arr2, int n) {
        int i = m - 1;   // last valid index in arr1
        int j = n - 1;   // last index in arr2
        int k = m + n - 1; // last index in merged arr1

        while (i >= 0 && j >= 0) {
            if (arr1[i] > arr2[j]) {
                arr1[k] = arr1[i];
                i--;
            } else {
                arr1[k] = arr2[j];
                j--;
            }
            k--;
        }

        // Copy remaining elements from arr2 if any
        while (j >= 0) {
            arr1[k] = arr2[j];
            j--;
            k--;
        }
    }

    public static void main(String[] args) {
        int[] arr1 = {1, 3, 5, 7,0,0,0,0}; // first 4 are valid
        int[] arr2 = {2, 4, 6, 8};

        int m = 4;
        int n = 4;

        merge(arr1, m, arr2, n);

        System.out.println(Arrays.toString(arr1));
        // Output: [1, 2, 3, 4, 5, 6, 7, 8]
    }
}

