public class MinimumElement {
    static void main() {
        int arr[]={1,20,300,4000,50000,600000,7000000,80000000,900000000,1000000000};
        int min=Integer.MAX_VALUE;
        for (int e :arr){
            if (e < min) {
                min=e;
            }
        }
        System.out.println("Min Element: " + min);
    }
}
